pkgbase = llama.cpp-cuda-tqp
	pkgdesc = Port of Facebook's LLaMA model in C/C++ (with NVIDIA CUDA optimizations and TurboQuant+)
	pkgver = b10760
	pkgrel = 1
	url = https://github.com/TheTom/llama-cpp-turboquant
	arch = x86_64
	license = MIT
	makedepends = cmake
	makedepends = cudnn
	makedepends = git
